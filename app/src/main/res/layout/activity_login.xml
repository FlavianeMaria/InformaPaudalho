<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app"
    android:fillViewport="true"
    android:contentDescription="@string/tela_de_login"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <!-- Logo do Aplicativo -->
        <ImageView
            android:id="@+id/imgLogoLogin"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/informapaudalho"
            android:contentDescription="@null"
            android:layout_marginBottom="40dp" />

        <!-- Campo de E-mail -->
        <EditText
            android:id="@+id/edtEmailLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="@string/digite_o_seu_e_mail"
            android:inputType="textEmailAddress"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="emailAddress" />

        <!-- Campo de Senha -->
        <EditText
            android:id="@+id/edtSenhaLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="@string/digite_a_sua_senha"
            android:inputType="textPassword"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="32dp"
            android:autofillHints="password" />

        <!-- Botão Principal de Login -->
        <Button
            android:id="@+id/btnEntrar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/login"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Botão para Tela de Cadastro -->
        <Button
            android:id="@+id/btnIrParaCadastro"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/n_o_tem_cadastro"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>