<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app"
    android:padding="20dp"
    tools:context=".CarroSopaActivity">

    <!-- TÍTULO DA TELA -->
    <TextView
        android:id="@+id/tvTituloSopa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Carro da Sopa"
        android:textColor="@color/texto_app"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtituloSopa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Selecione o seu bairro para ver o cronograma da sopa:"
        android:textColor="@color/verde_app"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloSopa" />

    <!-- SELETOR DE BAIRROS (SPINNER) -->
    <Spinner
        android:id="@+id/spinnerBairrosSopa"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@android:drawable/btn_dropdown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtituloSopa" />

    <!-- CARD COM OS DETALHES DA ENTREGA -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDetalhesSopa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:visibility="gone"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinnerBairrosSopa"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvBairroNomeSopa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Bairro"
                android:textColor="@color/texto_app"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusSopa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Status: --"
                android:textColor="@color/verde_app"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDataSopa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Dia: --"
                android:textColor="@color/texto_app"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHorarioSopa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Horário: --"
                android:textColor="@color/texto_app"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>