<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- BARRA SUPERIOR -->
    <ImageButton
        android:id="@+id/imageButtonLogo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/logoo"
        android:scaleType="fitCenter"
        app:tint="@color/verde_app"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bara" />

    <TextView
        android:id="@+id/titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/informa_paudalhoo"
        android:textColor="@color/texto_app"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/imageButtonLogo"
        app:layout_constraintEnd_toStartOf="@id/buttonChecklist"
        app:layout_constraintStart_toEndOf="@id/imageButtonLogo"
        app:layout_constraintTop_toTopOf="@id/imageButtonLogo" />

    <ImageButton
        android:id="@+id/buttonChecklist"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/checklist"
        android:scaleType="fitCenter"
        app:tint="@color/verde_app"
        app:layout_constraintEnd_toStartOf="@id/buttonPerfil"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/checklist" />

    <ImageButton
        android:id="@+id/buttonPerfil"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/perfill"
        android:scaleType="fitCenter"
        app:tint="@color/verde_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/perfil" />

    <!-- LINHA 1: ÁGUA E CARRO DA SOPA -->
    <ImageButton
        android:id="@+id/buttonAgua"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/bot_o_gua"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@id/buttonCarroSopa"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageButtonLogo"
        app:srcCompat="@drawable/agua"
        app:tint="@color/verde_app" />

    <TextView
        android:id="@+id/textAgua"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/gua"
        android:textColor="@color/verde_app"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonAgua"
        app:layout_constraintStart_toStartOf="@id/buttonAgua"
        app:layout_constraintTop_toBottomOf="@id/buttonAgua" />

    <ImageButton
        android:id="@+id/buttonCarroSopa"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/bot_o_carro_da_sopa"
        android:scaleType="fitCenter"
        app:tint="@color/verde_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/buttonAgua"
        app:layout_constraintTop_toTopOf="@id/buttonAgua"
        app:srcCompat="@drawable/sopa" />

    <TextView
        android:id="@+id/textCarroSopa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/carro_da_sopaa"
        android:textColor="@color/verde_app"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonCarroSopa"
        app:layout_constraintStart_toStartOf="@id/buttonCarroSopa"
        app:layout_constraintTop_toBottomOf="@id/buttonCarroSopa" />

    <!-- LINHA 2: RECICLAGEM E CHAT -->
    <ImageButton
        android:id="@+id/buttonReciclagem"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/bot_o_reciclagem"
        android:scaleType="fitCenter"
        app:tint="@color/verde_app"
        app:layout_constraintEnd_toStartOf="@id/buttonChat"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textAgua"
        app:srcCompat="@drawable/reciclaguem" />

    <TextView
        android:id="@+id/textReciclagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/reciclagemm"
        android:textColor="@color/verde_app"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonReciclagem"
        app:layout_constraintStart_toStartOf="@id/buttonReciclagem"
        app:layout_constraintTop_toBottomOf="@id/buttonReciclagem" />

    <ImageButton
        android:id="@+id/buttonChat"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/bot_o_chat"
        android:scaleType="fitCenter"
        app:tint="@color/verde_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/buttonReciclagem"
        app:layout_constraintTop_toTopOf="@id/buttonReciclagem"
        app:srcCompat="@drawable/chat" />

    <TextView
        android:id="@+id/textChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/chatt"
        android:textColor="@color/verde_app"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonChat"
        app:layout_constraintStart_toStartOf="@id/buttonChat"
        app:layout_constraintTop_toBottomOf="@id/buttonChat" />

    <!-- LINHA 3: COLETA DE LIXO E CASTRAÇÃO MÓVEL -->
    <ImageButton
        android:id="@+id/buttonColetaLixo"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/bot_o_coleta_de_lixo"
        android:scaleType="fitCenter"
        app:tint="@color/verde_app"
        app:layout_constraintEnd_toStartOf="@id/buttonCastraMovel"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textReciclagem"
        app:srcCompat="@drawable/caminhadolixo" />

    <TextView
        android:id="@+id/carredolixo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/coleta_do_lixo"
        android:textColor="@color/verde_app"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonColetaLixo"
        app:layout_constraintStart_toStartOf="@id/buttonColetaLixo"
        app:layout_constraintTop_toBottomOf="@id/buttonColetaLixo" />

    <ImageButton
        android:id="@+id/buttonCastraMovel"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/bot_o_castram_vel"
        android:scaleType="fitCenter"
        app:tint="@color/verde_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/buttonColetaLixo"
        app:layout_constraintTop_toTopOf="@id/buttonColetaLixo"
        app:srcCompat="@drawable/castramovel" />

    <TextView
        android:id="@+id/castramovel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/castram_vel"
        android:textColor="@color/verde_app"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonCastraMovel"
        app:layout_constraintStart_toStartOf="@id/buttonCastraMovel"
        app:layout_constraintTop_toBottomOf="@id/buttonCastraMovel" />

</androidx.constraintlayout.widget.ConstraintLayout>