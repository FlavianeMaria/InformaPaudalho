<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_app"
    android:padding="20dp"
    tools:context=".CastraMovelActivity">

    <!-- TÍTULO DA TELA -->
    <TextView
        android:id="@+id/tvTituloCastramovel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Castramóvel"
        android:textColor="@color/texto_app"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtituloCastramovel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Selecione o seu bairro para ver o ponto de atendimento:"
        android:textColor="@color/verde_app"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloCastramovel" />

    <!-- SELETOR DE BAIRROS -->
    <Spinner
        android:id="@+id/spinnerBairrosCastramovel"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@android:drawable/btn_dropdown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtituloCastramovel" />

    <!-- CARD COM OS DETALHES -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDetalhesCastramovel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:visibility="gone"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinnerBairrosCastramovel"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvBairroNomeCastramovel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Bairro"
                android:textColor="@color/texto_app"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusCastramovel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Status: --"
                android:textColor="@color/verde_app"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvLocalCastramovel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Local: --"
                android:textColor="@color/texto_app"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDataCastramovel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Período: --"
                android:textColor="@color/texto_app"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHorarioCastramovel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Atendimento: --"
                android:textColor="@color/texto_app"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>